{
  "openapi": "3.1.0",
  "info": {
    "title": "SignGate Decision API v0.1",
    "version": "0.1.0-preview",
    "description": "SignGate is the policy and execution control layer for autonomous agents. This Preview execution API evaluates deploy_change actions and returns ALLOW, REQUIRE_APPROVAL, or DENY. ALLOW is action-bound, time-limited, single-use, and is not executable until atomic consume succeeds. Production execution is not currently available in this preview."
  },
  "servers": [
    {
      "url": "https://{host}",
      "description": "Preview execution environment supplied by an authorized Nomos Labs integration.",
      "variables": {
        "host": {
          "default": "preview.signgate.local",
          "description": "Authorized Preview execution environment host. Production execution is not currently available in this preview."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Decisions",
      "description": "Evaluate an exact action, then atomically consume a verified ALLOW immediately before execution."
    }
  ],
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/v1/decisions": {
      "post": {
        "summary": "Evaluate a deploy_change action",
        "description": "Returns ALLOW, REQUIRE_APPROVAL, or DENY only after successful authentication, strict JSON/schema validation, canonical fingerprinting, policy evaluation, persistence, and audit. Every non-valid-ALLOW outcome fails closed.",
        "operationId": "createDecision",
        "tags": ["Decisions"],
        "x-codeSamples": [
          {
            "lang": "cURL",
            "source": "curl --fail-with-body --silent --show-error \\\n  \"$SIGNGATE_BASE_URL/v1/decisions\" \\\n  -H \"Authorization: Bearer $SIGNGATE_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  --data-binary @decision-request.json"
          },
          {
            "lang": "JavaScript",
            "source": "const response = await fetch(process.env.SIGNGATE_BASE_URL + '/v1/decisions', { method: 'POST', headers: { authorization: 'Bearer ' + process.env.SIGNGATE_API_KEY, 'content-type': 'application/json' }, body: JSON.stringify(request) });\nif (!response.ok) throw new Error('Execution stopped');"
          },
          {
            "lang": "Python",
            "source": "request = urllib.request.Request(os.environ['SIGNGATE_BASE_URL'] + '/v1/decisions', data=json.dumps(body).encode(), headers={'Authorization': 'Bearer ' + os.environ['SIGNGATE_API_KEY'], 'Content-Type': 'application/json'}, method='POST')"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DecisionRequest" },
              "examples": {
                "previewAllow": { "$ref": "#/components/examples/PreviewAllowRequest" },
                "permissionApproval": { "$ref": "#/components/examples/PermissionApprovalRequest" }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed policy evaluation. REQUIRE_APPROVAL and DENY do not authorize execution.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DecisionResponse" },
                "examples": {
                  "allow": { "$ref": "#/components/examples/AllowResponse" },
                  "requireApproval": { "$ref": "#/components/examples/RequireApprovalResponse" },
                  "deny": { "$ref": "#/components/examples/DenyResponse" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MalformedJson" },
          "401": { "$ref": "#/components/responses/AuthenticationFailed" },
          "403": { "$ref": "#/components/responses/AuthorizationFailed" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/SchemaInvalid" },
          "500": { "$ref": "#/components/responses/InvariantFailure" },
          "503": { "$ref": "#/components/responses/DependencyUnavailable" }
        }
      }
    },
    "/v1/decisions/{decision_id}/consume": {
      "post": {
        "summary": "Atomically consume an ALLOW decision",
        "description": "Consumes a valid ALLOW before execution. An ALLOW is not executable until this operation succeeds. The decision must be ALLOW, AVAILABLE, unexpired, organization-bound, fingerprint-bound, policy-bound, and unused.",
        "operationId": "consumeDecision",
        "tags": ["Decisions"],
        "x-codeSamples": [
          {
            "lang": "cURL",
            "source": "curl --fail-with-body --silent --show-error \\\n  \"$SIGNGATE_BASE_URL/v1/decisions/$DECISION_ID/consume\" \\\n  -H \"Authorization: Bearer $SIGNGATE_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  --data-binary @consume-request.json"
          },
          {
            "lang": "JavaScript",
            "source": "const response = await fetch(process.env.SIGNGATE_BASE_URL + '/v1/decisions/' + decisionId + '/consume', { method: 'POST', headers: { authorization: 'Bearer ' + process.env.SIGNGATE_API_KEY, 'content-type': 'application/json' }, body: JSON.stringify(request) });\nif (!response.ok) throw new Error('Execution stopped');"
          },
          {
            "lang": "Python",
            "source": "path = '/v1/decisions/' + decision_id + '/consume'\nrequest = urllib.request.Request(os.environ['SIGNGATE_BASE_URL'] + path, data=json.dumps(body).encode(), headers={'Authorization': 'Bearer ' + os.environ['SIGNGATE_API_KEY'], 'Content-Type': 'application/json'}, method='POST')"
          }
        ],
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^dec_[A-Za-z0-9_:-]+$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConsumeRequest" },
              "examples": { "consume": { "$ref": "#/components/examples/ConsumeRequest" } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The decision was consumed, or the same execution_attempt_id replayed the original receipt.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumeResponse" },
                "examples": { "receipt": { "$ref": "#/components/examples/ConsumeResponse" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MalformedJson" },
          "401": { "$ref": "#/components/responses/AuthenticationFailed" },
          "403": { "$ref": "#/components/responses/AuthorizationFailed" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/SchemaInvalid" },
          "500": { "$ref": "#/components/responses/InvariantFailure" },
          "503": { "$ref": "#/components/responses/DependencyUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Preview API key. Raw keys are never stored or logged by SignGate."
      }
    },
    "schemas": {
      "Decision": { "type": "string", "enum": ["ALLOW", "REQUIRE_APPROVAL", "DENY"] },
      "ExecutionDirectiveAction": { "type": "string", "enum": ["EXECUTE", "DO_NOT_EXECUTE"] },
      "DecisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_version", "request_id", "organization_id", "agent", "action", "mandate", "evidence"],
        "properties": {
          "contract_version": { "const": "0.1" },
          "request_id": { "type": "string", "description": "Organization-scoped idempotency key." },
          "organization_id": { "type": "string", "description": "Must exactly match the authenticated API credential organization." },
          "agent": { "$ref": "#/components/schemas/Agent" },
          "action": { "$ref": "#/components/schemas/DeployChangeAction" },
          "intent": { "type": "string", "maxLength": 1024, "description": "Descriptive only; never overrides policy." },
          "mandate": { "$ref": "#/components/schemas/Mandate" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "$ref": "#/components/schemas/Evidence" }
          },
          "context": { "$ref": "#/components/schemas/RequestContext" }
        }
      },
      "Agent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "authenticated_by"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["coding_agent"] },
          "authenticated_by": { "type": "string" }
        }
      },
      "DeployChangeAction": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target", "parameters"],
        "properties": {
          "type": { "const": "deploy_change" },
          "target": { "$ref": "#/components/schemas/DeployTarget" },
          "parameters": { "$ref": "#/components/schemas/DeployParameters" }
        }
      },
      "DeployTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["environment", "service", "repository"],
        "properties": {
          "environment": { "type": "string", "description": "The Preview execution environment is the currently documented executable scope. Production execution is not currently available in this preview." },
          "service": { "type": "string" },
          "project": { "type": "string" },
          "repository": { "$ref": "#/components/schemas/RepositoryIdentity" }
        }
      },
      "RepositoryIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "owner", "repo", "remote_url"],
        "properties": {
          "host": { "type": "string" },
          "owner": { "type": "string" },
          "repo": { "type": "string" },
          "remote_url": { "type": "string" }
        }
      },
      "DeployParameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["git_commit", "changed_paths", "changed_routes", "touches_secrets", "touches_dns", "touches_permissions", "deployment_strategy", "deployment_command_id", "configuration_fingerprint", "ci_evidence"],
        "properties": {
          "git_commit": { "type": "string" },
          "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "diff_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "changed_paths": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "maxLength": 512 },
            "description": "Set semantics: members are validated, exact duplicates removed, sorted deterministically, and case-distinct values preserved before fingerprinting."
          },
          "changed_routes": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "maxLength": 512 },
            "description": "Set semantics matching changed_paths."
          },
          "touches_secrets": { "type": "boolean" },
          "touches_dns": { "type": "boolean" },
          "touches_permissions": { "type": "boolean" },
          "touches_credentials": { "type": "boolean" },
          "deployment_strategy": { "type": "string" },
          "deployment_command_id": { "type": "string" },
          "configuration_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "ci_evidence": { "$ref": "#/components/schemas/CiEvidence" }
        },
        "anyOf": [{ "required": ["artifact_digest"] }, { "required": ["diff_digest"] }]
      },
      "CiEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "commit", "status", "checks"],
        "properties": {
          "provider": { "type": "string" },
          "run_id": { "type": "string" },
          "commit": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "checks": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Order is semantically significant for CI evidence."
          }
        }
      },
      "Mandate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "issued_by", "expires_at"],
        "properties": {
          "id": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "issued_by": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source", "status", "observed_at"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "source": { "type": "string" },
          "status": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "subject_fingerprint": { "type": "string" },
          "original_decision_id": { "type": "string" },
          "action_fingerprint": { "type": "string" },
          "policy_version": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "RequestContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "requested_at": { "type": "string", "format": "date-time" } }
      },
      "DecisionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_version", "api_status", "decision", "decision_id", "request_id", "organization_id", "action_fingerprint", "bound_action", "policy_version", "issued_at", "expires_at", "reason_codes", "required_checks", "approval", "execution_directive", "audit_id"],
        "properties": {
          "contract_version": { "const": "0.1" },
          "api_status": { "const": "preview" },
          "decision": { "$ref": "#/components/schemas/Decision" },
          "decision_id": { "type": "string" },
          "request_id": { "type": "string" },
          "organization_id": { "type": "string" },
          "action_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bound_action": { "$ref": "#/components/schemas/DeployChangeAction" },
          "policy_version": { "type": "string" },
          "issued_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "required_checks": { "type": "array", "items": { "type": "string" } },
          "approval": { "$ref": "#/components/schemas/ApprovalRequirement" },
          "execution_directive": { "$ref": "#/components/schemas/ExecutionDirective" },
          "audit_id": { "type": "string" }
        }
      },
      "ApprovalRequirement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required"],
        "properties": {
          "required": { "type": "boolean" },
          "role": { "type": "string" },
          "grant_binding_required": { "type": "boolean" }
        }
      },
      "ExecutionDirective": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "max_uses", "replay_protection"],
        "properties": {
          "action": { "$ref": "#/components/schemas/ExecutionDirectiveAction" },
          "max_uses": { "type": "integer", "minimum": 0, "maximum": 1 },
          "replay_protection": { "type": "string" }
        }
      },
      "ConsumeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_version", "organization_id", "action_fingerprint", "policy_version", "execution_attempt_id"],
        "properties": {
          "contract_version": { "const": "0.1" },
          "organization_id": { "type": "string" },
          "action_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "policy_version": { "type": "string" },
          "execution_attempt_id": { "type": "string" }
        }
      },
      "ConsumeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_version", "api_status", "receipt"],
        "properties": {
          "contract_version": { "const": "0.1" },
          "api_status": { "const": "preview" },
          "receipt": { "$ref": "#/components/schemas/ConsumeReceipt" }
        }
      },
      "ConsumeReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consume_receipt_id", "organization_id", "decision_id", "execution_attempt_id", "action_fingerprint", "policy_version", "executor_principal_id", "consumed_at"],
        "properties": {
          "consume_receipt_id": { "type": "string" },
          "organization_id": { "type": "string" },
          "decision_id": { "type": "string" },
          "execution_attempt_id": { "type": "string" },
          "action_fingerprint": { "type": "string" },
          "policy_version": { "type": "string" },
          "executor_principal_id": { "type": "string" },
          "consumed_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_version", "error", "reason_codes", "enforcement_effect"],
        "properties": {
          "contract_version": { "const": "0.1" },
          "error": { "type": "string" },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "request_id": { "type": "string" },
          "enforcement_effect": { "const": "DENY" },
          "audit_id": { "type": "string" }
        },
        "not": { "required": ["decision"] }
      }
    },
    "responses": {
      "MalformedJson": { "description": "Malformed JSON or invalid UTF-8. No policy decision enum is returned.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "AuthenticationFailed": { "description": "Authentication failed. Cross-tenant details are not enumerated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "AuthorizationFailed": { "description": "Authorization failure, wrong scope, or organization mismatch.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Conflict": { "description": "Request ID reuse mismatch, grant reuse mismatch, or consume conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "SchemaInvalid": { "description": "Strict schema or contract validation failed before fingerprinting.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "InvariantFailure": { "description": "Unexpected invariant or persistence failure. No policy decision enum is returned and no ALLOW is minted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "DependencyUnavailable": { "description": "Policy or dependency unavailable. No policy decision enum is returned and no ALLOW is minted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "examples": {
