          "execution_directive": { "action": "EXECUTE", "max_uses": 1, "replay_protection": "SERVICE_CONSUME_REQUIRED" },
          "audit_id": "audit_doc_001"
        }
      },
      "RequireApprovalResponse": {
        "value": {
          "contract_version": "0.1",
          "api_status": "preview",
          "decision": "REQUIRE_APPROVAL",
          "decision_id": "dec_doc_approval_001",
          "request_id": "req_doc_permission_001",
          "organization_id": "org_nomos_labs",
          "action_fingerprint": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bound_action": { "$ref": "#/components/examples/PermissionApprovalRequest/value/action" },
          "policy_version": "deploy_policy_2026_07_18_01",
          "issued_at": "2026-07-19T12:01:00Z",
          "expires_at": "2026-07-19T12:16:00Z",
          "reason_codes": ["PERMISSION_CHANGE_REQUIRES_APPROVAL"],
